    "./fuse": "./src/fuse.ts",
    "./generate": "./src/generate.ts",
    "./parse": "./src/parse.ts",
    "./retrieve": "./src/retrieve.ts",
    "./store": "./src/store.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
